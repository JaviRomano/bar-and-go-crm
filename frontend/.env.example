# Copiar a .env.local (ignorado por git). Vite solo expone variables con prefijo VITE_.

# URL base de la API
VITE_API_BASE_URL=http://localhost:8080/api

# Mostrar los accesos rápidos con credenciales de demo en un build de producción.
# En desarrollo (npm run dev) se muestran siempre. Solo tiene sentido si el backend corre con el perfil dev.
VITE_SHOW_DEMO_LOGIN=false
