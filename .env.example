# Copiar a .env y ajustar valores. .env no se versiona.

# PostgreSQL (docker-compose y backend)
DB_HOST=localhost
# Si ya hay un PostgreSQL local en 5432, usar otro puerto (p. ej. 5433)
DB_PORT=5432
DB_NAME=bar_and_go
DB_USER=bar_and_go
DB_PASSWORD=cambiar-esta-password

# JWT: clave HMAC en Base64 de al menos 32 bytes. Generar con: openssl rand -base64 32
JWT_SECRET=
# Validez del token en formato ISO-8601
JWT_EXPIRATION=PT2H

# Orígenes permitidos por CORS, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173
